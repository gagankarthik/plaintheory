# PlainTheory environment variables
# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Core (Phase 0)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3030"

# ---------------------------------------------------------------------------
# AWS (Phase 0 — region; rest provisioned in later phases)
# ---------------------------------------------------------------------------
AWS_REGION="us-east-2"
# Local dev only — production uses Vercel env vars + IAM roles for Lambdas.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ---------------------------------------------------------------------------
# Cognito (Phase 2 — auth)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_COGNITO_USER_POOL_ID=""
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=""
# OAuth (Google + Apple)
NEXT_PUBLIC_COGNITO_OAUTH_DOMAIN=""
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
APPLE_OAUTH_CLIENT_ID=""
APPLE_OAUTH_TEAM_ID=""
APPLE_OAUTH_KEY_ID=""
APPLE_OAUTH_PRIVATE_KEY=""

# Server session cookie signing (32+ random bytes, base64)
SESSION_COOKIE_SECRET=""

# ---------------------------------------------------------------------------
# Data layer (Phase 3)
# ---------------------------------------------------------------------------
DYNAMODB_TABLE_NAME="plaintheory-prod"
KMS_KEY_ID=""
S3_BUCKET_NAME="plaintheory-user-content-prod"

# ---------------------------------------------------------------------------
# OpenAI (Phase 4 — daily plan + chat)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=""
# Configurable so models can swap without code changes.
OPENAI_MODEL_REASONING="gpt-4o"
OPENAI_MODEL_CLASSIFIER="gpt-4o-mini"

# ---------------------------------------------------------------------------
# Stripe (Phase 8 — billing)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PLUS_MONTHLY=""
STRIPE_PRICE_PLUS_YEARLY=""
STRIPE_PRICE_PREMIUM_MONTHLY=""
